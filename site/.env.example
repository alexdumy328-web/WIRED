# Copy to .env.local for development. Names and comments only; never commit real values.

# Database (accounts, sessions, bookings, settings, audit log). Without it the API uses a JSON file
# and the account and dashboard routes answer 503.
MONGODB_URI=
MONGODB_DB=norgelis

# Better Auth. The secret is required in production (32+ characters, e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. https://norgelis.ro. In development it defaults to http://localhost:5173.
BETTER_AUTH_URL=
# Comma separated extra origins allowed to call the API with cookies. Default in development: http://localhost:5173.
APP_ORIGINS=

# Google sign-in. The button is hidden when either is empty.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email through Resend. With a key but no verified domain, Resend only delivers to the account owner.
# Without both values, development writes messages to the dev outbox and production answers 503.
RESEND_API_KEY=
MAIL_FROM=

# Role bootstrap: comma separated emails that get the role once their address is verified.
OWNER_EMAILS=
DEV_EMAILS=

# Drivers: comma separated emails that get the driver role (pickups and deliveries only) once verified.
DRIVER_EMAILS=

# Demo accounts for the iOS app (App Review, demos): comma separated verified emails. The app shows sample data for
# them. They must hold no staff role (a listed address that is also in OWNER_EMAILS or DEV_EMAILS is a real account).
DEMO_EMAILS=

# Legacy header token for PATCH /api/bookings/:code/status. Unset disables that route.
ADMIN_TOKEN=

# Set to 1 (or a proxy list) when the API runs behind a reverse proxy, so client IPs are read correctly.
TRUST_PROXY=

# AI estimate (optional).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Pickup rate defaults (the owner dashboard overrides them).
PICKUP_DIESEL_LEI_PER_L=
PICKUP_CONSUMPTION_L_PER_100=
PICKUP_DRIVER_LEI_PER_HOUR=
PICKUP_STOP_MINUTES=
PICKUP_MIN_TRIP_LEI=
PICKUP_MAX_KM=
PICKUP_URGENT_FACTOR=
